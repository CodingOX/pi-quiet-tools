{
  "name": "pi-quiet-tools",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi glue extension: hashline editing + quiet aggregate tool UI. One install, minimal terminal noise.",
  "main": "index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "hashline",
    "tool-display"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@zhcsyncer/pi-tool-display-intent": "^0.9.0",
    "pi-hashline-edit-pro": "^2.6.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0 <1",
    "@earendil-works/pi-tui": ">=0.80.0 <1"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "update:upstream": "bash scripts/update-upstream.sh",
    "update:upstream:latest": "bash scripts/update-upstream.sh --latest",
    "update:upstream:check": "bash scripts/update-upstream.sh --check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
