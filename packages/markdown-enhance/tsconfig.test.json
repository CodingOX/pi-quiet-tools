{
  "//": "markdown-enhance 测试用 tsconfig。与 core / 兄弟包同规则：不放任何 paths，tsx 会把 paths 当运行时解析表，遮蔽真实依赖。",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": "../..",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  }
}
