{
  "name": "@pi-quiet-tools/markdown-enhance",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi markdown transformer: mermaid diagram dialects, GitHub admonitions, bare-URL linkify, plus opt-in code-fence hiding and circled-digit normalisation.",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "markdown",
    "mermaid"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "grok-mermaid": "^0.2.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0 <1",
    "@earendil-works/pi-tui": ">=0.84.0 <1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npx --yes tsx --tsconfig tsconfig.test.json --test src/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
