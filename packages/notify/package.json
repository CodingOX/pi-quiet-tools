{
  "name": "@pi-quiet-tools/notify",
  "version": "0.1.0",
  "type": "module",
  "description": "Compact one-line renderer for Pi subagent completion notifications (hides transcript paths and result previews).",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "notifications",
    "subagents"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./renderer": "./src/quiet-subagent-notifications.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0 <1",
    "@earendil-works/pi-tui": ">=0.84.0 <1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npx --yes tsx --tsconfig tsconfig.test.json --test src/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
